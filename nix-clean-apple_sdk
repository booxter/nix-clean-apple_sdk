        "name": "Handle X = optionals isDarwin [] ++",
        "action": lambda content: re.sub(r"(\s*(\w+)\s*=\s*)[\w\.]*optionals\s*[\w\.]*isDarwin\s*\[\s*\]\s*\+\+", r"\1", content),
