# TODO: This is ugly.
def argument_is_used(content, argument):
    match_variable = r".*\${" + argument + "}"
    if (re.match(rf".*\s*{argument}\.\w+\s*", content, flags=re.DOTALL) or
        re.match(f"{match_variable}", content, flags=re.DOTALL)):
        return True
    return False


def clear_comments_above(lines):
    new_lines = lines[:]
    for i in range(len(new_lines) - 1, -1, -1):
        line = new_lines[i]
        if line.strip() == "":
            continue
        if line.strip().startswith("#"):
            new_lines.pop(i)
        else:
            break
    return new_lines


def remove_argument(argument, content):
    if argument_is_used(content, argument):
        return content
    lines = content.splitlines()
    new_lines = []
    reached_end = False
    for line in lines:
        if reached_end:
            new_lines.append(line)
            continue
        if '}' in line:
            new_lines.append(line)
            reached_end = True
            continue
        if re.match(rf"\s*{argument}\s*,", line) or re.match(rf"\s*,\s*{argument}\s*", line):
            new_lines = clear_comments_above(new_lines)
            continue
        new_lines.append(line)
    return "\n".join(new_lines)


def inherit_is_used(content, inherit):
    found_body = False
    for line in content.splitlines():
        if found_body:
            if re.match(rf".*inherit.*{inherit}.*;", line):
                continue
            if re.match(rf".*{inherit}", line):
                return True
        if line != "let":
            continue
        found_body = True
    return False


def remove_inherit(inherit, content):
    if inherit_is_used(content, inherit):
        return content
    lines = content.splitlines()
    new_lines = []
    reached_end = False
    for line in lines:
        if reached_end:
            new_lines.append(line)
            continue
        if line == "in":
            new_lines.append(line)
            reached_end = True
            continue
        if re.match(rf".*inherit\s*\(.*\)\s*{inherit};", line):
            continue
        new_lines.append(line)
    return "\n".join(new_lines)


def remove_frameworks_from_lists(content, skip_frameworks=None):
    for framework in frameworks:
        if skip_frameworks and framework in skip_frameworks:
            continue
        content = re.sub(rf"(\[[^\]\"]*?\s+)(({framework}|[\w\.]+\.{framework})\n)(.*?\])", r"\1\4", content, flags=re.DOTALL)
    return content


# Avoid duplicate names defined in subpackage sets
def get_skip_frameworks():
    if "perl-packages" in _FILENAME:
        return [
            "Tcl",
            "Tk",
            "OpenGL",
        ]
    return []


